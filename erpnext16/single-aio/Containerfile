# ERPNext16 single-container application stack.
#
# Runtime architecture:
#   - nginx
#   - gunicorn backend
#   - socketio
#   - worker
#   - scheduler
#
# MariaDB and Redis are ALWAYS external.
# This image intentionally contains no bundled MariaDB/Redis service.
#
# Ashan source remains in its independent Git repository. GitHub Actions
# vendors a snapshot into custom-apps/ashan_cn_procurement before this build.

ARG FRAPPE_IMAGE_TAG=version-16
ARG FRAPPE_BRANCH=version-16

FROM frappe/build:${FRAPPE_IMAGE_TAG} AS builder

ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_PATH=https://github.com/frappe/frappe
ARG APPS_JSON_BASE64

USER root

RUN test -n "${APPS_JSON_BASE64}" && \
    mkdir -p /opt/frappe && \
    printf '%s' "${APPS_JSON_BASE64}" | base64 -d > /opt/frappe/apps.json

COPY custom-apps/ashan_cn_procurement /opt/ashan_cn_procurement
RUN chown -R frappe:frappe /opt/ashan_cn_procurement

USER frappe

RUN bench init \
      --apps_path=/opt/frappe/apps.json \
      --frappe-branch="${FRAPPE_BRANCH}" \
      --frappe-path="${FRAPPE_PATH}" \
      --no-procfile \
      --no-backups \
      --skip-redis-config-generation \
      --verbose \
      /home/frappe/frappe-bench && \
    cd /home/frappe/frappe-bench && \
    cp -a /opt/ashan_cn_procurement apps/ashan_cn_procurement && \
    env/bin/python -m pip install --no-deps -e apps/ashan_cn_procurement && \
    env/bin/python -c "import frappe, erpnext, ashan_cn_procurement" && \
    printf 'frappe\nerpnext\nashan_cn_procurement\n' > sites/apps.txt && \
    APP_PUBLIC="/home/frappe/frappe-bench/apps/ashan_cn_procurement/ashan_cn_procurement/public" && \
    ASSET_LINK="/home/frappe/frappe-bench/sites/assets/ashan_cn_procurement" && \
    mkdir -p sites/assets && \
    if [ -d "${APP_PUBLIC}" ]; then \
      rm -rf "${ASSET_LINK}" && \
      ln -s "${APP_PUBLIC}" "${ASSET_LINK}"; \
    fi && \
    echo '{}' > sites/common_site_config.json && \
    find apps -mindepth 2 -type d -name .git -prune -exec rm -rf {} +

FROM frappe/base:${FRAPPE_IMAGE_TAG} AS runtime

ARG FRAPPE_IMAGE_TAG=version-16
ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_PATH=https://github.com/frappe/frappe

USER root

# No mariadb-server, mariadb-client, redis-server or redis-tools here.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      supervisor \
      nginx \
      gettext-base \
      curl \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder --chown=frappe:frappe \
  /home/frappe/frappe-bench \
  /home/frappe/frappe-bench

# Deterministic image identity used to refresh generated assets on a persistent
# sites volume after an image upgrade.
RUN /bin/sh -ec 'set -eu; \
    cd /home/frappe/frappe-bench; \
    { \
      printf "%s\n" \
        "FRAPPE_IMAGE_TAG='"${FRAPPE_IMAGE_TAG}"'" \
        "FRAPPE_BRANCH='"${FRAPPE_BRANCH}"'" \
        "FRAPPE_PATH='"${FRAPPE_PATH}"'"; \
      printf "%s\n" "frappe" "erpnext" "ashan_cn_procurement"; \
      find sites/assets -type f -exec sha256sum {} + 2>/dev/null || true; \
      find apps/ashan_cn_procurement -type f -exec sha256sum {} + 2>/dev/null || true; \
    } | sha256sum | awk "{print \$1}" > sites/.image-build-id'

# Preserve image-generated assets and metadata outside the sites volume.
RUN mkdir -p /opt/sites-skel && \
    cp -a /home/frappe/frappe-bench/sites/. /opt/sites-skel/ && \
    chown -R frappe:frappe /opt/sites-skel

COPY single-aio/rootfs/ /

# External-only image must not accidentally inherit old internal-service files
# from the source tree.
RUN rm -f \
      /etc/supervisor/conf.d/00-mariadb.conf \
      /etc/supervisor/conf.d/00-redis.conf \
      /usr/local/bin/run-mariadb.sh \
      /usr/local/bin/run-redis.sh && \
    chmod +x \
      /usr/local/bin/entrypoint.sh \
      /usr/local/bin/run-backend.sh \
      /usr/local/bin/run-worker.sh \
      /usr/local/bin/aio-healthcheck.sh

VOLUME ["/home/frappe/frappe-bench/sites"]

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
  CMD /usr/local/bin/aio-healthcheck.sh

STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
